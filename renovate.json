{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "ignoreTests": true,
  "schedule": ["* * * * *"],
  "postUpdateOptions": ["helmUpdateSubChartArchives"],
  "packageRules": [
    {
      "description": "Automerge patch/minor docker image and Helm chart bumps",
      "matchDatasources": ["docker", "helm"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "description": "Never automerge major docker image or Helm chart bumps",
      "matchDatasources": ["docker", "helm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Bump the dashboard's Bun image and tool pin together, and never automerge: its checks run locally (bun run verify)",
      "matchPackageNames": ["oven/bun", "bun"],
      "groupName": "bun",
      "automerge": false
    }
  ]
}
