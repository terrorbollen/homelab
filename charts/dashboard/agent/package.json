{
  "name": "dashboard-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun server.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "gen:types": "openapi-typescript https://raw.githubusercontent.com/Sonarr/Sonarr/develop/src/Sonarr.Api.V3/openapi.json -o types/sonarr.ts && openapi-typescript https://raw.githubusercontent.com/Radarr/Radarr/develop/src/Radarr.Api.V3/openapi.json -o types/radarr.ts",
    "format": "prettier --write . ../index.html",
    "format:check": "prettier --check . ../index.html",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "eslint": "10.14.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
