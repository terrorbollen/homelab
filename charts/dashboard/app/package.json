{
  "name": "dashboard-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun agent/server.ts",
    "dev": "bun dev.ts",
    "tunnel": "while true; do kubectl -n dashboard port-forward svc/dashboard-agent 18090:80; sleep 1; done",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "verify": "prettier --check . && eslint . && tsc --noEmit && bun test",
    "gen:types": "openapi-typescript https://raw.githubusercontent.com/Sonarr/Sonarr/develop/src/Sonarr.Api.V3/openapi.json -o types/sonarr.ts && openapi-typescript https://raw.githubusercontent.com/Radarr/Radarr/develop/src/Radarr.Api.V3/openapi.json -o types/radarr.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.4",
    "eslint": "10.15.0",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
